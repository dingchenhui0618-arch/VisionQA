# Test-experience environment. Keep false for formal production.
VISIONQA_TEST_ENVIRONMENT=false
VISIONQA_TEST_INVITE_TOKEN=
VISIONQA_RELEASE_MODE=prelaunch
VISIONQA_PAYMENT_PROVIDER=disabled
VISIONQA_ASSET_URL_SIGNING_SECRET=

# DeepSeek V4 Flash is a server-side structured repair planner. It never receives image bytes.
VISIONQA_ORCHESTRATOR_DEEPSEEK_API_KEY=
VISIONQA_ORCHESTRATOR_DEEPSEEK_APPROVED=false
VISIONQA_ORCHESTRATOR_DEEPSEEK_PAID_CALLS_APPROVED=false
VISIONQA_ORCHESTRATOR_DEEPSEEK_DATA_SCOPE=STRUCTURED_REPAIR_FACTS_NO_IMAGES
VISIONQA_ORCHESTRATOR_DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen Image 3 is the server-side image repair executor.
VISION_REPAIR_QWEN_API_KEY=
VISION_REPAIR_QWEN_WORKSPACE_ID=
VISION_REPAIR_QWEN_APPROVED=false
VISION_REPAIR_QWEN_PAID_CALLS_APPROVED=false
VISION_REPAIR_QWEN_DATA_SCOPE=MODEL_DRAFT_AND_PRODUCT_REFERENCES
VISION_REPAIR_QWEN_IMAGE_3_MODEL=qwen-image-3.0-pro
