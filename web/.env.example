# Test-experience environment. Keep false for formal production.
VISIONQA_TEST_ENVIRONMENT=false
VISIONQA_TEST_INVITE_TOKEN=
# Hosted test only: comma-separated, unique customer invites. When set, this
# takes precedence over VISIONQA_TEST_INVITE_TOKEN. Never expose it to clients.
VISIONQA_TEST_INVITE_TOKENS=
VISIONQA_RELEASE_MODE=prelaunch
VISIONQA_PAYMENT_PROVIDER=disabled
VISIONQA_ASSET_URL_SIGNING_SECRET=

# DeepSeek V4 Flash is a server-side structured repair planner. It never receives image bytes.
VISIONQA_ORCHESTRATOR_DEEPSEEK_API_KEY=
VISIONQA_ORCHESTRATOR_DEEPSEEK_APPROVED=false
VISIONQA_ORCHESTRATOR_DEEPSEEK_PAID_CALLS_APPROVED=false
VISIONQA_ORCHESTRATOR_DEEPSEEK_DATA_SCOPE=STRUCTURED_REPAIR_FACTS_NO_IMAGES
VISIONQA_ORCHESTRATOR_DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen Image 3 is the server-side image repair executor.
VISION_REPAIR_QWEN_API_KEY=
VISION_REPAIR_QWEN_WORKSPACE_ID=
VISION_REPAIR_QWEN_APPROVED=false
VISION_REPAIR_QWEN_PAID_CALLS_APPROVED=false
VISION_REPAIR_QWEN_DATA_SCOPE=MODEL_DRAFT_AND_PRODUCT_REFERENCES
VISION_REPAIR_QWEN_IMAGE_3_MODEL=qwen-image-3.0-pro

# One server-side user-owned multimodal profile. The endpoint must expose an
# OpenAI-compatible /chat/completions contract; never put this key in the
# Chrome extension or browser bundle.
VISION_MULTIMODAL_ENABLED=false
VISION_MULTIMODAL_ENDPOINT=
VISION_MULTIMODAL_API_KEY=
VISION_MULTIMODAL_MODEL=
VISION_MULTIMODAL_PROVIDER_ID=user-multimodal
VISION_MULTIMODAL_MAX_TOTAL_REQUESTS=15

# Electron desktop shell only. Keep the switch off by default. In `real` mode
# the local web server reads the allow-listed provider values from the external
# file below; the file must stay outside the repository and desktop bundle.
VISIONQA_DESKTOP_PROVIDER_MODE=off
VISIONQA_DESKTOP_SECRETS_FILE=
VISIONQA_HOST_REQUEST_TIMEOUT_MS=60000
VISIONQA_CHROME_EXTENSION_ID=audit

# React Bits Pro registry (local install only; never expose to the browser)
REACTBITS_LICENSE_KEY=
