{
  "name": "visionqa-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:local": "node scripts/start-local.mjs",
    "dev:preview": "node scripts/start-local.mjs --preview",
    "visual:capabilities": "node --experimental-strip-types scripts/visual-review-cli.ts capabilities",
    "visual:review": "node --experimental-strip-types scripts/visual-review-cli.ts review",
    "visual:validate": "node --experimental-strip-types scripts/visual-review-cli.ts validate",
    "visual:mcp": "node --experimental-strip-types scripts/visual-review-mcp.ts",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:release",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:prepare": "npm run test:release && npm run release:manifest",
    "release:export": "node scripts/export-release.mjs",
    "test:release": "node scripts/release-check.mjs",
    "test:contracts": "node --experimental-strip-types --test tests/visual-review-contract.test.ts tests/review-contract-v0.2.test.ts tests/review-profiles.test.ts tests/host-adapter.test.ts tests/multimodal-provider.test.ts",
    "test:plugin": "npx tsx --test tests/visual-plugin-runtime.test.ts tests/plugin-runtime-v02.test.ts tests/m2-host-fixtures.test.ts tests/host-evidence-v02.test.ts tests/review-ui-adapter.test.ts tests/mcp-host-contract.test.ts tests/host-evidence-route.test.ts tests/host-adapter.test.ts tests/multimodal-provider.test.ts tests/desktop-provider-config.test.mjs",
    "test:adapters": "node --experimental-strip-types --test tests/model-adapter.test.ts",
    "test:agent": "npm run test:plugin",
    "test:production-smoke": "node --test tests/production-smoke.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "materials:manifest": "node scripts/build-local-material-manifest.mjs",
    "desktop:dev": "electron ../desktop/main.mjs",
    "desktop:test": "node --test ../desktop/tests/alpha-boundary.test.mjs ../desktop/tests/portable-package.test.mjs ../desktop/tests/provider-settings.test.mjs",
    "desktop:portable": "node ../desktop/scripts/create-portable.mjs",
    "desktop:builder:portable": "electron-builder --projectDir ../desktop --config electron-builder.yml --win portable",
    "desktop:builder:mac": "electron-builder --projectDir ../desktop --config electron-builder.yml --mac zip",
    "desktop:mac:bundle": "node ../desktop/scripts/create-mac-bundle.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@mastra/core": "1.65.0",
    "@mastra/libsql": "1.22.4",
    "@modelcontextprotocol/server": "2.0.0",
    "@react-three/fiber": "^9.8.2",
    "drizzle-orm": "0.45.2",
    "motion": "^14.6.0",
    "next": "16.2.6",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5",
    "three": "^0.186.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "^8.17.1",
    "drizzle-kit": "0.31.10",
    "electron": "38.2.0",
    "electron-builder": "26.18.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pg-mem": "^3.0.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.4",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
