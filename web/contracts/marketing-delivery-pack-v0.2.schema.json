{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.local/contracts/marketing-delivery-pack-v0.2.schema.json",
  "title": "Marketing Delivery Pack v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_name", "source", "evidence_status", "agent_run_id", "agent_execution_mode", "claim_ledger", "creator_profiles", "real_creator_candidates", "pain_point_map", "social_copy", "verbatim_scripts", "information_flow_video_outline", "video_generation_prompts", "review_issues", "prohibited_claims", "human_final_review_required"],
  "properties": {
    "schema_version": { "const": "marketing-delivery-pack-v0.2" },
    "product_name": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "evidence_status": { "enum": ["DEMO_ONLY", "HUMAN_REVIEW_REQUIRED"] },
    "agent_run_id": { "type": "string", "minLength": 1 },
    "agent_execution_mode": { "enum": ["LOCAL_RULES_NO_NETWORK", "L2_RUNTIME_TEST_PROVIDER_NO_NETWORK"] },
    "claim_ledger": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "statement", "basis", "source_ref", "status"] } },
    "creator_profiles": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "real_creator_candidates": { "type": "array", "items": { "type": "object" } },
    "pain_point_map": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["audience", "scene", "friction", "response", "evidence"] } },
    "social_copy": { "type": "object", "required": ["小红书", "抖音"] },
    "verbatim_scripts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "lines"] } },
    "information_flow_video_outline": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "video_generation_prompts": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "object", "required": ["name", "text"] } },
    "review_issues": { "type": "array", "items": { "type": "string" } },
    "prohibited_claims": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "human_final_review_required": { "const": true }
  }
}
