* text=auto

# Runtime and deployment files must keep Unix line endings.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary design and evaluation assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
