{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.local/data/repair_benchmark_v0.1/gold-label-template-v0.1.json",
  "title": "VisionQA Repair Benchmark Gold Label v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "status", "evidence_mode", "asset_integrity", "sku_truth", "repair_scope", "acceptance_contract", "provenance"],
  "properties": {
    "schema_version": {"const": "visionqa-repair-benchmark-gold-label-v0.1"},
    "case_id": {"type": "string", "pattern": "^RB-[0-9]{3}$"},
    "status": {"enum": ["NOT_RUN", "DRAFT_LABEL", "READY_FOR_BLIND_REVIEW", "ACCEPTED", "REWORK_REQUIRED", "BLOCKED"]},
    "evidence_mode": {"enum": ["SYNTHETIC_INTERNAL_TEST_ONLY", "AUTHORIZED_REAL_EVALUATION", "MATERIALS_REQUIRED"]},
    "asset_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_file", "candidate_sha256", "truth_files", "truth_sha256", "authorization_status"],
      "properties": {
        "candidate_file": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "truth_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "truth_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}},
        "authorization_status": {"enum": ["AUTHORIZED_FOR_INTERNAL_EVALUATION", "SYNTHETIC_INTERNAL_TEST_ONLY", "MISSING_OR_UNCONFIRMED"]}
      }
    },
    "sku_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id", "verified_attributes", "reference_scope"],
      "properties": {
        "sku_id": {"type": "string", "minLength": 1},
        "verified_attributes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reference_scope": {"enum": ["FULL_SKU", "FRONT_ONLY", "STYLE_ONLY", "BLOCKED"]}
      }
    },
    "repair_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_category", "target_region", "expected_problem", "allowed_strategy", "forbidden_change_regions", "regenerate_trigger"],
      "properties": {
        "primary_category": {"type": "string", "minLength": 1},
        "target_region": {"type": "string", "minLength": 1},
        "expected_problem": {"type": "string", "minLength": 1},
        "allowed_strategy": {"enum": ["LOCAL_REPAIR", "DETERMINISTIC_COMPOSITE", "LOCAL_REPAIR_OR_DETERMINISTIC_COMPOSITE", "LOCAL_REPAIR_OR_REGENERATE", "DETERMINISTIC_RESAMPLE_OR_BLOCK", "REGENERATE"]},
        "forbidden_change_regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "regenerate_trigger": {"type": "string", "minLength": 1}
      }
    },
    "acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_repair", "sku_consistency", "person_identity", "non_target_drift", "delivery_usability", "human_final_review_required", "auto_pass_enabled"],
      "properties": {
        "target_repair": {"type": "string", "minLength": 1},
        "sku_consistency": {"type": "string", "minLength": 1},
        "person_identity": {"type": "string", "minLength": 1},
        "non_target_drift": {"type": "string", "minLength": 1},
        "delivery_usability": {"type": "string", "minLength": 1},
        "human_final_review_required": {"const": true},
        "auto_pass_enabled": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labeler_id", "label_date", "execution_claim", "notes"],
      "properties": {
        "labeler_id": {"type": "string", "minLength": 1},
        "label_date": {"type": "string", "format": "date"},
        "execution_claim": {"enum": ["NO_MODEL_CALL", "EXTERNAL_EXECUTION_RECORDED_SEPARATELY"]},
        "notes": {"type": "string"}
      }
    }
  },
  "template_instance": {
    "schema_version": "visionqa-repair-benchmark-gold-label-v0.1",
    "case_id": "RB-001",
    "status": "NOT_RUN",
    "evidence_mode": "SYNTHETIC_INTERNAL_TEST_ONLY",
    "asset_integrity": {
      "candidate_file": "../synthetic_demo_sku_burgundy_trousers_v0.1/ai-model-draft-controlled-defect.png",
      "candidate_sha256": "D57A189C93CB209818EB5AF0F9A427E846041CB4618337B1760895E9A72A7C9E",
      "truth_files": ["../synthetic_demo_sku_burgundy_trousers_v0.1/product-truth-grid.png"],
      "truth_sha256": ["0C99B3D019B80E584A6EC34EFC8694F592668A08D5F28E6F11F0AC9784FFD305"],
      "authorization_status": "SYNTHETIC_INTERNAL_TEST_ONLY"
    },
    "sku_truth": {
      "sku_id": "SYN-VQA-BURGUNDY-TROUSERS-001",
      "verified_attributes": ["深酒红", "直筒裤型", "纵向微褶", "两侧缝口袋", "无工装口袋", "无 Logo 与文字"],
      "reference_scope": "FULL_SKU"
    },
    "repair_scope": {
      "primary_category": "GARMENT_STRUCTURE",
      "target_region": "画面左侧（模特右腿）大腿外侧的错误矩形翻盖工装口袋",
      "expected_problem": "商品真值不存在工装口袋；仅需移除该多余结构并连续恢复面料。",
      "allowed_strategy": "LOCAL_REPAIR",
      "forbidden_change_regions": ["人物身份与脸部", "姿势/手部/双腿与双鞋", "背景/镜头/裁切/光线", "腰头/抽绳/侧缝口袋/裤脚", "目标区外面料与结构"],
      "regenerate_trigger": "输出改变完整人物构图、裤型或多个非目标商品结构，或无法恢复连续纵向微褶。"
    },
    "acceptance_contract": {
      "target_repair": "错误翻盖工装口袋已移除，目标区呈连续深酒红纵向微褶面料。",
      "sku_consistency": "裤型、腰头、抽绳、侧缝口袋、裤脚、颜色和无 Logo/字标仍符合 SKU 真值。",
      "person_identity": "同一完整成年男性模特、脸部、姿势、手部、双腿和双鞋仍可见。",
      "non_target_drift": "除目标区外不出现不可接受的商品、人物、背景、画幅或光影变化；现有粗粒度漂移 Gate 仅是人工复验前置检查。",
      "delivery_usability": "保持原 2:3 画幅；若要求 4K，只可标注为尺寸重采样，不得宣称细节重建。",
      "human_final_review_required": true,
      "auto_pass_enabled": false
    },
    "provenance": {
      "labeler_id": "UNASSIGNED",
      "label_date": "2026-08-27",
      "execution_claim": "NO_MODEL_CALL",
      "notes": "计划标签。尚未将任何输出送入盲测，不引用现有 ImageGen 候选作为本基准的运行结果。"
    }
  }
}
