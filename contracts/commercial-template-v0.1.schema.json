{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.local/contracts/commercial-template-v0.1.schema.json",
  "title": "VisionQA Commercial Template v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "template_version",
    "name",
    "status",
    "context",
    "submetrics",
    "fit_bands",
    "calibration_policy",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "template_version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["DRAFT", "VALIDATING", "ACTIVE", "RETIRED"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "placement",
        "brand_positioning",
        "commercial_objectives",
        "visual_tones"
      ],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "placement": { "type": "string", "minLength": 1 },
        "brand_positioning": { "type": "string", "minLength": 1 },
        "commercial_objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "visual_tones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "submetrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "weight",
          "question",
          "positive_anchors",
          "negative_anchors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^COM-[A-Z0-9_-]+$"
          },
          "name": { "type": "string", "minLength": 1 },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "question": { "type": "string", "minLength": 1 },
          "positive_anchors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "negative_anchors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "fit_bands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "minimum", "maximum", "action"],
        "properties": {
          "label": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "minimum": { "type": "number", "minimum": 0, "maximum": 100 },
          "maximum": { "type": "number", "minimum": 0, "maximum": 100 },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "calibration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_event_updates_profile",
        "required_reviewers",
        "minimum_accepted_events",
        "requires_versioned_application"
      ],
      "properties": {
        "single_event_updates_profile": { "const": false },
        "required_reviewers": { "type": "integer", "minimum": 1 },
        "minimum_accepted_events": { "type": "integer", "minimum": 1 },
        "requires_versioned_application": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_collection_id",
        "performance_evidence",
        "calibration_status"
      ],
      "properties": {
        "seed_collection_id": { "type": "string", "minLength": 1 },
        "performance_evidence": {
          "enum": ["AVAILABLE", "PARTIAL", "NOT_AVAILABLE"]
        },
        "calibration_status": {
          "enum": ["DEMO", "UNCALIBRATED", "CALIBRATED"]
        }
      }
    }
  }
}
