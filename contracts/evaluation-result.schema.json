{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.local/contracts/evaluation-result.schema.json",
  "title": "Vision QA Evaluation Result",
  "description": "Provider-neutral contract. The model produces observations; a deterministic rule engine produces gates and the publication decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "input",
    "scope",
    "model_evaluation",
    "rule_evaluation",
    "performance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "created_at",
        "code_version",
        "dataset_version",
        "taxonomy_version",
        "gates_version",
        "prompt_version",
        "provider_adapter_version",
        "model_snapshot"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "code_version": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "taxonomy_version": { "type": "string", "minLength": 1 },
        "gates_version": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "provider_adapter_version": { "type": "string", "minLength": 1 },
        "model_snapshot": {
          "description": "Opaque provider-returned model identifier; no provider-specific semantics are assumed.",
          "type": "string",
          "minLength": 1
        },
        "configuration_hash": { "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_sha256", "scenario", "reference_asset_ids"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "asset_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "scenario": {
          "type": "string",
          "const": "fashion_ecommerce_ai_model_image"
        },
        "reference_asset_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_fidelity",
        "brand_guideline",
        "channel_requirements",
        "compliance"
      ],
      "properties": {
        "product_fidelity": { "$ref": "#/$defs/scopeStatus" },
        "brand_guideline": { "$ref": "#/$defs/scopeStatus" },
        "channel_requirements": { "$ref": "#/$defs/scopeStatus" },
        "compliance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "mode"],
          "properties": {
            "status": { "$ref": "#/$defs/scopeStatusValue" },
            "mode": {
              "type": "string",
              "enum": ["VISUAL_SCREENING_ONLY", "POLICY_RULESET_PROVIDED", "LEGAL_REVIEWED"]
            },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "model_evaluation": {
      "description": "Probabilistic observation layer. It must not issue PASS/REVIEW/REJECT.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observations", "warnings"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "NOT_RUN",
            "INSUFFICIENT_INPUT",
            "UNREADABLE_ASSET",
            "PROVIDER_ERROR",
            "TIMEOUT",
            "INVALID_OUTPUT"
          ]
        },
        "status_detail": { "type": "string" },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "raw_response_ref": {
          "description": "Reference to separately stored raw output; must not contain credentials.",
          "type": "string"
        }
      }
    },
    "rule_evaluation": {
      "description": "Deterministic layer computed from validated observations, scope and versioned gate rules.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision",
        "decision_reason",
        "gate_hits",
        "dimension_scores",
        "required_human_checks",
        "recommended_actions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SUCCEEDED", "NOT_RUN", "INVALID_MODEL_OUTPUT", "RULE_ENGINE_ERROR"]
        },
        "decision": {
          "type": ["string", "null"],
          "enum": ["PASS", "REVIEW", "REJECT", null]
        },
        "decision_reason": { "type": "string" },
        "decision_confidence": {
          "description": "Optional calibrated confidence. Thresholds are not defined in v0.1.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "gate_hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateHit" }
        },
        "dimension_scores": {
          "description": "Optional soft scores for explanation only; never offset a gate hit.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product_fidelity": { "$ref": "#/$defs/nullableScore" },
            "human_integrity": { "$ref": "#/$defs/nullableScore" },
            "garment_material": { "$ref": "#/$defs/nullableScore" },
            "photographic_physics": { "$ref": "#/$defs/nullableScore" },
            "composition_commercial": { "$ref": "#/$defs/nullableScore" },
            "text_logo": { "$ref": "#/$defs/nullableScore" },
            "compliance": { "$ref": "#/$defs/nullableScore" },
            "assessability": { "$ref": "#/$defs/nullableScore" }
          }
        },
        "overall_score": {
          "description": "Reserved for future calibrated use. Must remain null until weights and mapping are validated.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "required_human_checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "related_observation_ids"],
            "properties": {
              "action": { "type": "string", "minLength": 1 },
              "related_observation_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "attempt_count", "cost"],
      "properties": {
        "latency_ms": { "type": "integer", "minimum": 0 },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "amount", "currency"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["REPORTED", "ESTIMATED", "UNAVAILABLE", "NOT_APPLICABLE"]
            },
            "amount": { "type": ["number", "null"], "minimum": 0 },
            "currency": {
              "type": ["string", "null"],
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "scopeStatusValue": {
      "type": "string",
      "enum": ["VERIFIED", "LIMITED", "NOT_VERIFIED", "NOT_APPLICABLE"]
    },
    "scopeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/scopeStatusValue" },
        "reason": { "type": "string" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "coordinate_space", "label"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "coordinate_space": {
          "type": "string",
          "enum": ["NORMALIZED_0_1", "PIXEL", "FULL_IMAGE", "UNSPECIFIED"]
        },
        "label": { "type": "string", "minLength": 1 },
        "bounding_box": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "issue_code",
        "category",
        "severity",
        "status",
        "region",
        "observation",
        "impact",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "issue_code": {
          "type": "string",
          "pattern": "^(PF|HI|GM|PP|CC|TL|CO|AS)-[0-9]{2}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "product_fidelity",
            "human_integrity",
            "garment_material",
            "photographic_physics",
            "composition_commercial",
            "text_logo",
            "compliance",
            "assessability"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["blocker", "major", "minor", "information_insufficient"]
        },
        "status": {
          "type": "string",
          "enum": ["detected", "suspected", "not_assessable"]
        },
        "region": { "$ref": "#/$defs/region" },
        "observation": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "related_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "product_fidelity",
              "human_integrity",
              "garment_material",
              "photographic_physics",
              "composition_commercial",
              "text_logo",
              "compliance",
              "assessability"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "gateHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "result", "related_observation_ids", "rule_version"],
      "properties": {
        "gate_id": {
          "type": "string",
          "enum": [
            "product_fidelity",
            "human_integrity",
            "text_logo",
            "compliance",
            "assessability",
            "major_aggregation",
            "minor_aggregation"
          ]
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "REVIEW", "REJECT", "NOT_EVALUATED"]
        },
        "related_observation_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "rule_version": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      }
    },
    "nullableScore": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 4
    }
  }
}
