{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.local/contracts/evaluation-result-v0.2.schema.json",
  "title": "VisionQA Evaluation Result v0.2",
  "description": "Provider-neutral contract for four-Skill scoring, deterministic release gates, commercial assessment and repair prompts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "input",
    "scope",
    "model_evaluation",
    "score_evaluation",
    "gate_evaluation",
    "action_plan",
    "performance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "created_at",
        "model_snapshot",
        "prompt_version",
        "taxonomy_version",
        "score_policy_version",
        "threshold_policy_version",
        "gate_policy_version"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "model_snapshot": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "taxonomy_version": { "type": "string", "minLength": 1 },
        "score_policy_version": { "type": "string", "minLength": 1 },
        "threshold_policy_version": { "type": "string", "minLength": 1 },
        "gate_policy_version": { "type": "string", "minLength": 1 },
        "code_version": { "type": "string" },
        "dataset_version": { "type": "string" },
        "provider_adapter_version": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_sha256",
        "scenario",
        "reference_asset_ids",
        "locked_attributes"
      ],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "asset_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "scenario": {
          "const": "fashion_ecommerce_ai_model_image"
        },
        "reference_asset_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "locked_attributes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_reference",
        "brand_guideline",
        "channel_requirements",
        "compliance"
      ],
      "properties": {
        "product_reference": { "$ref": "#/$defs/scopeStatus" },
        "brand_guideline": { "$ref": "#/$defs/scopeStatus" },
        "channel_requirements": { "$ref": "#/$defs/scopeStatus" },
        "compliance": { "$ref": "#/$defs/scopeStatus" }
      }
    },
    "model_evaluation": {
      "description": "Probabilistic observation layer. It cannot issue release decisions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observations", "warnings"],
      "properties": {
        "status": {
          "enum": [
            "SUCCEEDED",
            "NOT_RUN",
            "INSUFFICIENT_INPUT",
            "UNREADABLE_ASSET",
            "PROVIDER_ERROR",
            "TIMEOUT",
            "INVALID_OUTPUT"
          ]
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "raw_response_ref": { "type": "string" }
      }
    },
    "score_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "calibration_status",
        "skill_scores",
        "overall_score",
        "score_band",
        "commercial_assessment"
      ],
      "properties": {
        "status": {
          "enum": ["SUCCEEDED", "PARTIAL", "NOT_RUN", "INVALID_OBSERVATIONS"]
        },
        "calibration_status": {
          "enum": ["DEMO", "UNCALIBRATED", "CALIBRATED"]
        },
        "skill_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_realism",
            "photography_realism",
            "material_realism",
            "commercial_value"
          ],
          "properties": {
            "human_realism": { "$ref": "#/$defs/skillScore" },
            "photography_realism": { "$ref": "#/$defs/skillScore" },
            "material_realism": { "$ref": "#/$defs/skillScore" },
            "commercial_value": { "$ref": "#/$defs/skillScore" }
          }
        },
        "overall_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "score_band": {
          "type": ["string", "null"],
          "enum": ["PASS_CANDIDATE", "REVIEW_OPTIMIZE", "REJECT_REWORK", null]
        },
        "commercial_assessment": {
          "$ref": "#/$defs/commercialAssessment"
        }
      }
    },
    "gate_evaluation": {
      "description": "Deterministic release gate. Confirmed blockers override all scores.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "decision_reason", "gate_hits"],
      "properties": {
        "status": {
          "enum": ["SUCCEEDED", "NOT_RUN", "INVALID_MODEL_OUTPUT", "RULE_ERROR"]
        },
        "decision": {
          "type": ["string", "null"],
          "enum": ["PASS", "REVIEW", "REJECT", null]
        },
        "decision_reason": { "type": "string" },
        "gate_hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateHit" }
        }
      }
    },
    "action_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_prompt", "required_human_checks"],
      "properties": {
        "repair_prompt": {
          "type": ["object", "null"],
          "oneOf": [
            { "$ref": "#/$defs/repairPrompt" },
            { "type": "null" }
          ]
        },
        "required_human_checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "attempt_count", "cost_status"],
      "properties": {
        "latency_ms": { "type": "integer", "minimum": 0 },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "cost_status": {
          "enum": ["REPORTED", "ESTIMATED", "UNAVAILABLE", "NOT_APPLICABLE"]
        },
        "cost_amount": { "type": ["number", "null"], "minimum": 0 },
        "cost_currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  },
  "$defs": {
    "scopeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["VERIFIED", "LIMITED", "NOT_VERIFIED", "NOT_APPLICABLE"]
        },
        "reason": { "type": "string" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "coordinate_space", "label"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "coordinate_space": {
          "enum": ["NORMALIZED_0_1", "PIXEL", "FULL_IMAGE", "UNSPECIFIED"]
        },
        "label": { "type": "string", "minLength": 1 },
        "bounding_box": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "issue_code",
        "primary_skill",
        "category",
        "severity",
        "status",
        "region",
        "observation",
        "impact",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "issue_code": {
          "type": "string",
          "pattern": "^(PF|HI|GM|PP|CC|TL|CO|AS)-[0-9]{2}$"
        },
        "primary_skill": {
          "type": ["string", "null"],
          "enum": ["HUM", "PHO", "MAT", "COM", null]
        },
        "category": {
          "enum": [
            "product_fidelity",
            "human_integrity",
            "garment_material",
            "photographic_physics",
            "composition_commercial",
            "text_logo",
            "compliance",
            "assessability"
          ]
        },
        "severity": {
          "enum": ["blocker", "major", "minor", "information_insufficient"]
        },
        "status": {
          "enum": ["detected", "suspected", "not_assessable"]
        },
        "region": { "$ref": "#/$defs/region" },
        "observation": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "skillScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "weight",
        "assessability",
        "related_observation_ids",
        "summary"
      ],
      "properties": {
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "assessability": {
          "enum": ["FULL", "LIMITED", "NOT_ASSESSABLE"]
        },
        "related_observation_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "commercialAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_focus",
        "selling_point_expression",
        "click_motivation",
        "brand_fit",
        "placement_fit",
        "summary"
      ],
      "properties": {
        "product_focus": { "type": "string", "minLength": 1 },
        "selling_point_expression": { "type": "string", "minLength": 1 },
        "click_motivation": { "type": "string", "minLength": 1 },
        "brand_fit": { "type": "string", "minLength": 1 },
        "placement_fit": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "gateHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "result",
        "related_observation_ids",
        "rule_version",
        "reason"
      ],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "result": {
          "enum": ["PASS", "REVIEW", "REJECT", "NOT_EVALUATED"]
        },
        "related_observation_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "rule_version": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "repairPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "prompt",
        "locked_attributes",
        "repair_actions",
        "commercial_actions",
        "negative_constraints",
        "related_observation_ids",
        "template_version"
      ],
      "properties": {
        "strategy": {
          "enum": ["LOCAL_EDIT", "REGENERATE", "MANUAL_REVIEW"]
        },
        "prompt": { "type": "string", "minLength": 1 },
        "locked_attributes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "repair_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "commercial_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "negative_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "related_observation_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "template_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
