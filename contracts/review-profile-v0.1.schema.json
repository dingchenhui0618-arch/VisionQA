{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.dionysusding.cn/contracts/review-profile-v0.1.schema.json",
  "title": "VisionQA Review Profile v0.1",
  "$ref": "#/$defs/ReviewProfileDefinition",
  "$defs": {
    "ProfileRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "type": "string", "enum": ["builtin", "workspace", "user", "host"], "default": "builtin" }
      }
    },
    "Dimension": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 1000 },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "ReviewProfileDefinition": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "profile", "review_mode", "title", "dimensions"],
      "properties": {
        "schema_version": { "const": "review-profile-v0.1" },
        "profile": { "$ref": "#/$defs/ProfileRef" },
        "review_mode": { "type": "string", "enum": ["visual", "code", "linked"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 2000 },
        "dimensions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/Dimension" } },
        "deterministic_checks": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "forbidden_inferences": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "type": "string", "minLength": 1, "maxLength": 240 }, "updated_at": { "type": "string", "maxLength": 80 } } }
      }
    }
  }
}
