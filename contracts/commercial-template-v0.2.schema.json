{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.local/contracts/commercial-template-v0.2.schema.json",
  "title": "VisionQA Commercial Template v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "template_version", "name", "status", "context", "submetrics", "fit_bands", "calibration_policy", "provenance"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "template_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "template_version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "VALIDATING", "ACTIVE", "RETIRED"] },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "placement", "brand_positioning", "commercial_objectives", "visual_tones"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "placement": { "type": "string", "minLength": 1 },
        "brand_positioning": { "type": "string", "minLength": 1 },
        "commercial_objectives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "visual_tones": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "submetrics": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/productProminence" },
        { "$ref": "#/$defs/sellingPointClarity" },
        { "$ref": "#/$defs/promotionHierarchy" },
        { "$ref": "#/$defs/informationLegibility" },
        { "$ref": "#/$defs/clickMotivation" },
        { "$ref": "#/$defs/channelPlacementFit" }
      ],
      "items": false
    },
    "fit_bands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/highBand" },
        { "$ref": "#/$defs/mediumBand" },
        { "$ref": "#/$defs/lowBand" }
      ],
      "items": false
    },
    "calibration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["single_event_updates_profile", "required_reviewers", "minimum_accepted_events", "requires_versioned_application"],
      "properties": {
        "single_event_updates_profile": { "const": false },
        "required_reviewers": { "type": "integer", "minimum": 2 },
        "minimum_accepted_events": { "type": "integer", "minimum": 1 },
        "requires_versioned_application": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_collection_id", "performance_evidence", "calibration_status"],
      "properties": {
        "seed_collection_id": { "type": "string", "minLength": 1 },
        "performance_evidence": { "enum": ["AVAILABLE", "PARTIAL", "NOT_AVAILABLE"] },
        "calibration_status": { "enum": ["DEMO", "UNCALIBRATED", "CALIBRATED"] }
      }
    }
  },
  "$defs": {
    "metricBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weight", "question", "positive_anchors", "negative_anchors"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number" },
        "question": { "type": "string", "minLength": 1 },
        "positive_anchors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "negative_anchors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "productProminence": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "id": { "const": "product_prominence" }, "weight": { "const": 0.25 } } }] },
    "sellingPointClarity": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "id": { "const": "selling_point_clarity" }, "weight": { "const": 0.2 } } }] },
    "promotionHierarchy": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "id": { "const": "promotion_hierarchy" }, "weight": { "const": 0.2 } } }] },
    "informationLegibility": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "id": { "const": "information_legibility" }, "weight": { "const": 0.15 } } }] },
    "clickMotivation": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "id": { "const": "click_motivation" }, "weight": { "const": 0.1 } } }] },
    "channelPlacementFit": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "id": { "const": "channel_placement_fit" }, "weight": { "const": 0.1 } } }] },
    "bandBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "minimum", "maximum", "action"],
      "properties": {
        "label": { "type": "string" },
        "minimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "highBand": { "allOf": [{ "$ref": "#/$defs/bandBase" }, { "properties": { "label": { "const": "HIGH" }, "minimum": { "const": 90 }, "maximum": { "const": 100 } } }] },
    "mediumBand": { "allOf": [{ "$ref": "#/$defs/bandBase" }, { "properties": { "label": { "const": "MEDIUM" }, "minimum": { "const": 70 }, "maximum": { "const": 89.999 } } }] },
    "lowBand": { "allOf": [{ "$ref": "#/$defs/bandBase" }, { "properties": { "label": { "const": "LOW" }, "minimum": { "const": 0 }, "maximum": { "const": 69.999 } } }] }
  }
}
