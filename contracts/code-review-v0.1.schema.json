{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqa.dionysusding.cn/contracts/code-review-v0.1.schema.json",
  "title": "VisionQA CodeReview Contract v0.1",
  "oneOf": [{ "$ref": "#/$defs/CodeReviewRequest" }, { "$ref": "#/$defs/CodeReviewResponse" }],
  "$defs": {
    "Host": { "type": "object", "additionalProperties": false, "required": ["type", "adapter_version"], "properties": { "type": { "type": "string", "minLength": 1 }, "adapter_version": { "type": "string", "minLength": 1 } } },
    "ProfileRef": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["builtin", "workspace", "user", "host"] } } },
    "Intent": { "type": "object", "additionalProperties": false, "required": ["goal"], "properties": { "goal": { "type": "string", "minLength": 1 }, "audience": { "type": "string" }, "platform": { "type": "string" }, "brand_profile": { "type": "string" } } },
    "Constraints": { "type": "object", "additionalProperties": false, "properties": { "must_keep": { "type": "array", "items": { "type": "string" }, "maxItems": 32 }, "must_change": { "type": "array", "items": { "type": "string" }, "maxItems": 32 }, "style_profile": { "type": "string" }, "rubric_profile": { "type": "string" } } },
    "Permissions": { "type": "object", "additionalProperties": false, "properties": { "can_read_source": { "type": "boolean" }, "can_write_source": { "type": "boolean" }, "can_call_model": { "type": "boolean" }, "can_render": { "type": "boolean" }, "can_run_commands": { "type": "boolean" } } },
    "Rect": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 } } },
    "EvidenceAnchor": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "rect"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "pixel_bbox" }, "description": { "type": "string", "minLength": 1 }, "rect": { "$ref": "#/$defs/Rect" }, "page": { "type": "integer", "minimum": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "selector"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "dom_selector" }, "description": { "type": "string", "minLength": 1 }, "selector": { "type": "string", "minLength": 1 }, "rect": { "$ref": "#/$defs/Rect" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "file", "start_line", "end_line"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "source_range" }, "description": { "type": "string", "minLength": 1 }, "file": { "type": "string", "minLength": 1 }, "start_line": { "type": "integer", "minimum": 1 }, "end_line": { "type": "integer", "minimum": 1 }, "start_column": { "type": "integer", "minimum": 1 }, "end_column": { "type": "integer", "minimum": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "object_id", "page"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "slide_object" }, "description": { "type": "string", "minLength": 1 }, "object_id": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 }, "rect": { "$ref": "#/$defs/Rect" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "page", "rect"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "document_region" }, "description": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 }, "rect": { "$ref": "#/$defs/Rect" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "kind", "description", "text"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "text_range" }, "description": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "start_offset": { "type": "integer", "minimum": 0 }, "end_offset": { "type": "integer", "minimum": 0 } } }
    ] },
    "SourceArtifact": { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "minLength": 1 }, "language": { "type": "string" }, "content_ref": { "type": "string" }, "diff_ref": { "type": "string" }, "ast_ref": { "type": "string" } } },
    "Context": { "type": "object", "additionalProperties": false, "properties": { "conversation": { "type": "array", "maxItems": 48 }, "dom_summary": { "type": "string" }, "source_summary": { "type": "string" }, "comparison_revision_id": { "type": "string" } } },
    "ObservationEnvelope": { "type": "object", "required": ["schema_version", "review_mode", "profile", "observations"], "additionalProperties": false, "properties": { "schema_version": { "const": "observation-envelope-v0.1" }, "review_mode": { "type": "string", "enum": ["visual", "code", "linked"] }, "profile": { "$ref": "#/$defs/ProfileRef" }, "observations": { "type": "array", "maxItems": 64, "items": { "type": "object" } }, "generated_at": { "type": "string" } } },
    "Verification": { "type": "object", "additionalProperties": false, "required": ["required", "checks"], "properties": { "required": { "type": "boolean" }, "checks": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1 } } } },
    "Usage": { "type": "object", "additionalProperties": false, "required": ["mode", "provider"], "properties": { "mode": { "type": "string", "enum": ["mock", "byok", "host_managed", "managed"] }, "provider": { "type": "string", "minLength": 1 }, "model": { "type": "string" }, "estimated_cost_minor_units": { "type": "integer", "minimum": 0 }, "latency_ms": { "type": "integer", "minimum": 0 } } },
    "RepairPlan": { "type": "object", "additionalProperties": false, "required": ["type", "requires_approval", "operations"], "properties": { "type": { "type": "string", "enum": ["source_patch", "structured_edit", "image_edit", "manual_plan", "none"] }, "requires_approval": { "const": true }, "operations": { "type": "array", "maxItems": 16, "items": { "type": "object", "required": ["action"], "properties": { "action": { "type": "string" }, "target": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": false } } } },
    "CodeReviewRequest": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "request_id", "conversation_id", "host", "target", "source_artifacts", "intent", "profile", "operation"],
      "properties": {
        "schema_version": { "const": "code-review-v0.1" }, "request_id": { "type": "string", "minLength": 1 }, "conversation_id": { "type": "string", "minLength": 1 }, "host": { "$ref": "#/$defs/Host" }, "target": { "type": "string", "enum": ["source", "diff", "project"] }, "source_artifacts": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/SourceArtifact" } }, "intent": { "$ref": "#/$defs/Intent" }, "constraints": { "$ref": "#/$defs/Constraints" }, "profile": { "$ref": "#/$defs/ProfileRef" }, "context": { "$ref": "#/$defs/Context" }, "permissions": { "$ref": "#/$defs/Permissions" }, "operation": { "type": "string", "enum": ["review", "repair_plan", "verify"] }, "revision_id": { "type": "string" }
      }
    },
    "CodeIssue": { "type": "object", "additionalProperties": false, "required": ["id", "category", "severity", "confidence", "statement", "evidence", "suggested_fix"], "properties": { "id": { "type": "string", "minLength": 1 }, "category": { "type": "string", "minLength": 1 }, "severity": { "type": "string", "enum": ["blocker", "high", "medium", "low", "observation"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "rule_id": { "type": "string" }, "statement": { "type": "string", "minLength": 1 }, "evidence": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/EvidenceAnchor" } }, "suggested_fix": { "type": "string", "minLength": 1 } } },
    "CodeReviewResponse": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "request_id", "decision", "summary", "observations", "issues", "repair_plan", "verification", "usage"],
      "properties": {
        "schema_version": { "const": "code-review-v0.1" }, "request_id": { "type": "string", "minLength": 1 }, "decision": { "type": "string", "enum": ["PASS", "NEEDS_REVISION", "MANUAL_REVIEW", "BLOCKED", "NEEDS_CONTEXT", "NOT_ASSESSABLE"] }, "summary": { "type": "string", "minLength": 1 }, "observations": { "$ref": "#/$defs/ObservationEnvelope" }, "issues": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/CodeIssue" } }, "repair_plan": { "$ref": "#/$defs/RepairPlan" }, "verification": { "$ref": "#/$defs/Verification" }, "usage": { "$ref": "#/$defs/Usage" }
      }
    }
  }
}
